# Comma-separated API keys for per-provider round-robin load balancing.
OPENAI_API_KEYS=sk-openai-key-a,sk-openai-key-b
XAI_API_KEYS=xai-key-a,xai-key-b
GOOGLE_API_KEYS=google-key-a,google-key-b
MISTRAL_API_KEYS=mistral-key-a,mistral-key-b
OPENAI_MODEL=gpt-5.4
XAI_MODEL=grok-4-1
GOOGLE_MODEL=gemini-3.1
MISTRAL_MODEL=mistral-large-latest

# Optional provider endpoints.
OPENAI_BASE_URL=https://api.openai.com/v1
XAI_BASE_URL=https://api.x.ai/v1
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Per-key request ceilings. The app waits when the active key reaches its budget.
OPENAI_REQUESTS_PER_MINUTE=60
XAI_REQUESTS_PER_MINUTE=60
GOOGLE_REQUESTS_PER_MINUTE=60
MISTRAL_REQUESTS_PER_MINUTE=60

DEFAULT_WORKERS=10
REQUEST_TIMEOUT_SECONDS=180
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=2
DATA_ROOT=data
OUTPUT_ROOT=output

# Dataset toggles: set to 0 to skip benchmarking a dataset entirely.
MEDMCQA=0
MEDQUAD=1
HEALTHBENCH=1

# Provider toggles: set to 0 to skip an entire provider's models.
OPENAI=1
XAI=1
GOOGLEAI=1
MISTRALAI=0
